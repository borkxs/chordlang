{
  "name": "@chordlang/parser",
  "version": "0.1.1",
  "description": "Peggy chart-structure parser for chordlang (.cfmd)",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "grammar": "mkdirp src/generated && peggy --format es -o src/generated/chart.mjs src/chart.peggy",
    "prebuild": "pnpm run grammar",
    "build": "tsc && cpy src/generated dist --parents",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borkxs/chordlang.git",
    "directory": "packages/parser"
  },
  "homepage": "https://github.com/borkxs/chordlang#readme",
  "bugs": "https://github.com/borkxs/chordlang/issues",
  "license": "MIT",
  "author": "Erik Michaelson <erik.michaelson@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "cpy-cli": "^7.0.0",
    "mkdirp": "^3.0.1",
    "peggy": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
