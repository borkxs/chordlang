{
  "name": "@chordlang/graph",
  "version": "0.1.0",
  "description": "Graphviz DOT → styled SVG for chordlang (.cfgv) harmonic graphs",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graph.css": "./graph.css"
  },
  "files": ["dist", "graph.css"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borkxs/chordlang.git",
    "directory": "packages/graph"
  },
  "homepage": "https://github.com/borkxs/chordlang#readme",
  "bugs": "https://github.com/borkxs/chordlang/issues",
  "license": "MIT",
  "author": "Erik Michaelson <erik.michaelson@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hpcc-js/wasm": "^2.22.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
