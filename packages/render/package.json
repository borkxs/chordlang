{
  "name": "@chordlang/render",
  "version": "0.1.1",
  "description": "Chart layout renderer — AST to engraved HTML (ChordFont consumer CSS included)",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart.css": "./chart.css"
  },
  "files": ["dist", "chart.css", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borkxs/chordlang.git",
    "directory": "packages/render"
  },
  "homepage": "https://github.com/borkxs/chordlang#readme",
  "bugs": "https://github.com/borkxs/chordlang/issues",
  "license": "MIT",
  "author": "Erik Michaelson <erik.michaelson@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@chordlang/chord": "workspace:*",
    "@chordlang/parser": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
