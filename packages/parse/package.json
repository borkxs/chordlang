{
  "name": "@chordlang/parse",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "grammar": "mkdir -p src/generated && peggy --format es -o src/generated/chart.mjs src/chart.peggy",
    "prebuild": "pnpm run grammar",
    "build": "tsc && cp -r src/generated dist/generated",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "peggy": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  }
}
